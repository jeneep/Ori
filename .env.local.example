# Copy this file to .env.local and fill in your Supabase project values.
# Find these in: Supabase Dashboard → Project Settings → API

# Bare project URL only — do NOT include /rest/v1 or /auth/v1 (causes
# "Invalid path specified in request URL" on signup/login).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional — canonical site origin for auth email redirects (defaults to
# window.location.origin). Production: https://ori-cyan.vercel.app
# NEXT_PUBLIC_SITE_URL=https://ori-cyan.vercel.app

# OpenAI — powers short summaries in /api/ingest
OPENAI_API_KEY=your-openai-api-key

# Optional — full auth user deletion for DELETE /api/account
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

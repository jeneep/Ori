# Copy this file to .env.local and fill in your Supabase project values.
# Find these in: Supabase Dashboard → Project Settings → API

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Grok / xAI — coach chat + short summaries in /api/ingest
# Prefer GROK_API_KEY; XAI_API_KEY and Grok_key also work.
GROK_API_KEY=your-grok-api-key
# XAI_API_KEY=your-xai-api-key
# Grok_key=your-grok-api-key
# GROK_MODEL=grok-4

# Optional — full auth user deletion for DELETE /api/account
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Supabase — use the bare project URL (no /rest/v1 or /auth/v1 suffix)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Optional canonical origin for email confirmation redirects
# NEXT_PUBLIC_SITE_URL=https://ori-cyan.vercel.app

# OpenAI (used by /api/ingest for short content summaries)
OPENAI_API_KEY=your-openai-api-key
# Optional override (defaults to gpt-4o-mini)
# OPENAI_MODEL=gpt-4o-mini

# Optional — enables full auth user deletion on account delete
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

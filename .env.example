# Supabase
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Grok / xAI (coach chat + /api/ingest summaries)
# Prefer GROK_API_KEY; XAI_API_KEY is also accepted.
GROK_API_KEY=your-grok-api-key
# XAI_API_KEY=your-xai-api-key
# Optional override (defaults to grok-4)
# GROK_MODEL=grok-4
# XAI_MODEL=grok-4

# Optional — enables full auth user deletion on account delete
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# OpenAI (legacy — no longer used by coach/ingest)
# OPENAI_API_KEY=your-openai-api-key
# OPENAI_MODEL=gpt-4o-mini
